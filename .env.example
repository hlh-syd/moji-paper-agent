# 论文智能体环境变量模板
# 复制为 .env 并填入真实值：
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env

# 必填：智谱 AI API Key（ https://open.bigmodel.cn/ ）
ZHIPU_API_KEY=your_zhipu_api_key_here

# 可选：PubMed API，提升方法文献检索限额（ https://www.ncbi.nlm.nih.gov/account/ ）
NCBI_EMAIL=your_email@example.com
NCBI_API_KEY=

# 可选：朱雀 AIGC 检测（tools/online_ai_check.py 使用）
ZHUQUE_API_KEY=

# 可选：DeepSeek（写作 / 项目理解 / 图片理解模型选 deepseek-4.1-flash 时需要）
DEEPSEEK_API_KEY=

# 可选：云 GPU SSH（distill_humanize/ 远程训练 helper _cloud_ssh.py 使用）
CLOUD_SSH_HOST=
CLOUD_SSH_PORT=22
CLOUD_SSH_USER=
CLOUD_SSH_PASSWORD=
